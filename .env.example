VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Optional. Defaults to http://127.0.0.1:5000 (a Flask relay running on
# this machine). Set this once the relay is deployed publicly (see
# backend/render.yaml) so live hardware data works from any network.
VITE_FLASK_URL=https://your-backend.onrender.com
